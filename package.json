{
  "name": "pstack-pi",
  "version": "0.2.0",
  "description": "Rigorous engineering workflows for Pi: upstream pstack's skills with a Pi adapter. Understand, design, implement, verify independently, ship, recover.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pstack",
    "workflow",
    "skills",
    "principles",
    "review"
  ],
  "pi": {
    "skills": [
      "./skills",
      "./local-skills"
    ],
    "extensions": [
      "./extensions/pstack.js"
    ],
    "subagents": {
      "agents": ["./adapter/agents"]
    }
  },
  "files": [
    "skills",
    "local-skills",
    "agents",
    "adapter",
    "extensions",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "LICENSE.upstream",
    "NOTICE.md",
    "upstream.lock"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  }
}
